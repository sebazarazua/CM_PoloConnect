{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polo Connect Quality Review",
  "type": "object",
  "required": [
    "review_id",
    "content_id",
    "review_stage",
    "review_mode",
    "decision",
    "scope",
    "versions",
    "source_of_truth",
    "issues",
    "checks",
    "approval",
    "observed_at"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "review_stage": {
      "enum": [
        "pre_render",
        "post_render",
        "pre_publish"
      ]
    },
    "review_mode": {
      "enum": [
        "full",
        "partial",
        "delta"
      ]
    },
    "decision": {
      "enum": [
        "pass_for_human_approval",
        "pass_for_publish",
        "changes_required",
        "blocked_verification",
        "blocked_rights",
        "blocked_compliance",
        "blocked_technical",
        "replan_required",
        "reject"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "surfaces_reviewed",
        "available_inputs",
        "missing_inputs"
      ],
      "properties": {
        "surfaces_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "available_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishing_route": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "versions": {
      "type": "object",
      "properties": {
        "asset_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "copy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_of_truth": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "fact",
          "status"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "fact": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "category",
          "surface",
          "problem",
          "impact",
          "owner",
          "required_fix",
          "recheck_scope",
          "status"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "note"
            ]
          },
          "category": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "problem": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "required_fix": {
            "type": "string"
          },
          "recheck_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "open",
              "fixed_pending_recheck",
              "closed",
              "accepted_non_material"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "facts",
        "editorial_alignment",
        "copy",
        "visual_or_video",
        "authenticity",
        "originality",
        "rights",
        "sponsor_compliance",
        "accessibility",
        "platform_preflight",
        "timing",
        "brand_integrity"
      ],
      "properties": {
        "facts": {
          "type": "string"
        },
        "editorial_alignment": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        },
        "visual_or_video": {
          "type": "string"
        },
        "authenticity": {
          "type": "string"
        },
        "originality": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "sponsor_compliance": {
          "type": "string"
        },
        "accessibility": {
          "type": "string"
        },
        "platform_preflight": {
          "type": "string"
        },
        "timing": {
          "type": "string"
        },
        "brand_integrity": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_required",
            "required_pending",
            "approved",
            "reapproval_required"
          ]
        },
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observed_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}