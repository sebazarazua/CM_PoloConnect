{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polo Connect Content Opportunity",
  "type": "object",
  "required": [
    "opportunity_id",
    "source_candidates",
    "eligibility",
    "strategy",
    "timing",
    "format",
    "assets",
    "decision",
    "handoff",
    "observed_at"
  ],
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "source_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_type": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "source_id"
        ]
      }
    },
    "eligibility": {
      "type": "object",
      "required": [
        "eligible",
        "blockers"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "primary_objective",
        "audience_job",
        "editorial_angle",
        "why_now",
        "why_polo_connect"
      ],
      "properties": {
        "primary_objective": {
          "type": "string"
        },
        "secondary_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audience_job": {
          "type": "string"
        },
        "editorial_angle": {
          "type": "string"
        },
        "why_now": {
          "type": "string"
        },
        "why_polo_connect": {
          "type": "string"
        },
        "benchmark_mechanisms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "timing_class"
      ],
      "properties": {
        "timing_class": {
          "enum": [
            "live",
            "reactive",
            "same_day",
            "scheduled",
            "evergreen",
            "seasonal"
          ]
        },
        "earliest_publish_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_publish_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "preferred",
        "reason"
      ],
      "properties": {
        "preferred": {
          "type": "string"
        },
        "fallback": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "object",
      "required": [
        "readiness",
        "production_complexity",
        "required_assets"
      ],
      "properties": {
        "readiness": {
          "enum": [
            "ready",
            "ready_with_light_work",
            "capture_required",
            "data_required",
            "permission_required",
            "missing_critical_asset"
          ]
        },
        "production_complexity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "required_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rights_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "state",
        "priority",
        "opportunity_score"
      ],
      "properties": {
        "state": {
          "enum": [
            "produce_now",
            "produce_scheduled",
            "merge",
            "story_only",
            "monitor",
            "hold",
            "blocked_verification",
            "blocked_assets",
            "reject"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "opportunity_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "merge_with": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "downstream_skill",
        "required_facts",
        "success_signal"
      ],
      "properties": {
        "downstream_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_signal": {
          "type": "string"
        },
        "learning_hypothesis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observed_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}