{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polo Connect Social Design Plan",
  "type": "object",
  "required": [
    "design_id",
    "opportunity_id",
    "state",
    "strategy",
    "output",
    "assets",
    "visual_system",
    "slides",
    "accessibility",
    "handoff",
    "observed_at"
  ],
  "properties": {
    "design_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "ready_for_render",
        "ready_with_asset_request",
        "blocked_assets",
        "blocked_verification",
        "blocked_rights",
        "brand_system_required",
        "replan_required"
      ]
    },
    "strategy": {
      "type": "object",
      "required": [
        "design_job",
        "primary_objective",
        "audience_job",
        "success_signal"
      ],
      "properties": {
        "design_job": {
          "type": "string"
        },
        "primary_objective": {
          "type": "string"
        },
        "audience_job": {
          "type": "string"
        },
        "success_signal": {
          "type": "string"
        },
        "benchmark_mechanisms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "surface",
        "structure",
        "aspect_intent",
        "slide_count",
        "render_path"
      ],
      "properties": {
        "surface": {
          "type": "string"
        },
        "structure": {
          "enum": [
            "single_image",
            "carousel",
            "story",
            "story_sequence",
            "graphic_frame_for_reel",
            "cover",
            "multi_surface_system"
          ]
        },
        "aspect_intent": {
          "type": "string"
        },
        "slide_count": {
          "type": "integer",
          "minimum": 1
        },
        "render_path": {
          "enum": [
            "canva",
            "adobe",
            "figma",
            "html_canvas",
            "image_renderer",
            "manual_designer",
            "existing_template_engine",
            "other"
          ]
        },
        "template_relationship": {
          "enum": [
            "existing_template",
            "template_variant",
            "new_reusable_system",
            "bespoke_editorial"
          ]
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "role",
          "rights_status",
          "required"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "path_or_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "rights_status": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "crop_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "credit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "visual_system": {
      "type": "object",
      "required": [
        "concept",
        "primary_carrier",
        "hierarchy",
        "type_roles",
        "color_roles",
        "brand_presence"
      ],
      "properties": {
        "concept": {
          "type": "string"
        },
        "primary_carrier": {
          "type": "string"
        },
        "hierarchy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brand_presence": {
          "type": "string"
        },
        "photo_treatment": {
          "type": [
            "string",
            "null"
          ]
        },
        "sponsor_treatment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "function",
          "primary_message",
          "layout_logic"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "function": {
            "type": "string"
          },
          "primary_message": {
            "type": "string"
          },
          "display_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "layout_logic": {
            "type": "string"
          },
          "continuity_note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "required": [
        "contrast_checked",
        "reading_order",
        "alt_text"
      ],
      "properties": {
        "contrast_checked": {
          "type": "boolean"
        },
        "reading_order": {
          "type": "string"
        },
        "alt_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "downstream_tool_or_skill",
        "must_preserve",
        "export_checks"
      ],
      "properties": {
        "downstream_tool_or_skill": {
          "type": "string"
        },
        "must_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renderer_freedom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "export_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observed_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}