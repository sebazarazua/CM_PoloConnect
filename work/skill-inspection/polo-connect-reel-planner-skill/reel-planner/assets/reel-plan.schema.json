{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polo Connect Reel Plan",
  "type": "object",
  "required": [
    "reel_id",
    "opportunity_id",
    "state",
    "strategy",
    "rights",
    "footage",
    "hook",
    "narrative",
    "text",
    "audio",
    "cover",
    "handoff",
    "observed_at"
  ],
  "properties": {
    "reel_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "ready_for_edit",
        "ready_with_capture_request",
        "blocked_assets",
        "blocked_verification",
        "blocked_rights",
        "replan_required"
      ]
    },
    "strategy": {
      "type": "object",
      "required": [
        "reel_job",
        "primary_objective",
        "audience_job",
        "success_signal"
      ],
      "properties": {
        "reel_job": {
          "type": "string"
        },
        "primary_objective": {
          "type": "string"
        },
        "audience_job": {
          "type": "string"
        },
        "success_signal": {
          "type": "string"
        },
        "target_duration_seconds": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 1
            },
            "max": {
              "type": "number",
              "minimum": 1
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "required": [
        "video_status",
        "audio_status"
      ],
      "properties": {
        "video_status": {
          "type": "string"
        },
        "audio_status": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "footage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "role",
          "selection_status",
          "rights_status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "in_timecode": {
            "type": [
              "string",
              "null"
            ]
          },
          "out_timecode": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "selection_status": {
            "enum": [
              "must_use",
              "strong_option",
              "context_only",
              "optional",
              "avoid"
            ]
          },
          "rights_status": {
            "type": "string"
          },
          "audio_value": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternative_hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "narrative": {
      "type": "object",
      "required": [
        "architecture",
        "beats"
      ],
      "properties": {
        "architecture": {
          "type": "string"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start_s",
              "end_s",
              "function",
              "visual"
            ],
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "function": {
                "type": "string"
              },
              "visual": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "overlay": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "audio": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "overlays",
        "subtitles_required"
      ],
      "properties": {
        "overlays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtitles_required": {
          "type": "boolean"
        },
        "subtitle_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessibility_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "mode",
        "preserve_source_audio"
      ],
      "properties": {
        "mode": {
          "enum": [
            "natural_sound_led",
            "commentary_led",
            "music_led",
            "voiceover_led",
            "hybrid"
          ]
        },
        "preserve_source_audio": {
          "type": "boolean"
        },
        "music_brief": {
          "type": [
            "string",
            "null"
          ]
        },
        "voiceover_brief": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "strategy",
        "source_frame"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "source_frame": {
          "type": "string"
        },
        "headline": {
          "type": [
            "string",
            "null"
          ]
        },
        "crop_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "brand_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "downstream_skill",
        "deadline",
        "must_preserve"
      ],
      "properties": {
        "downstream_skill": {
          "type": "string"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "must_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "editor_freedom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "export_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observed_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}