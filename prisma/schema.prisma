generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model StateStore {
  id String @id
  revision Int
  data Json
}
model NewsEvent {
  id String @id
  logicalKey String @unique
  revision Int
  fingerprint String
  sourceKeys String[]
  data Json
  history Json
  contents ContentItem[]
}
model ContentItem {
  workflowClass String?
  id String @id
  eventId String
  event NewsEvent @relation(fields: [eventId], references: [id])
  title String
  type String
  status String
  objective String
  audienceJob String
  priority String
  opportunityScore Float?
  createdAt DateTime
  updatedAt DateTime
  versions Json
  blockers Json
  opportunity Opportunity?
  plans CreativePlan[]
  copies CopyVersion[]
  assets AssetVersion[]
  metadata MetadataVersion[]
  reviews QualityReview[]
  approvals Approval[]
  publications Publication[]
  snapshots PerformanceSnapshot[]
  learnings Learning[]
  runs WorkflowRun[]
  @@index([status, priority])
}
model Opportunity {
  id String @id
  contentId String @unique
  content ContentItem @relation(fields: [contentId], references: [id])
  decision String
  data Json
}
model CreativePlan {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  version Int
  stale Boolean
  inputHash String
  data Json
  at DateTime
  @@unique([contentId, version])
}
model CopyVersion {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  version Int
  stale Boolean
  inputHash String
  data Json
  at DateTime
  @@unique([contentId, version])
}
model AssetVersion {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  version Int
  stale Boolean
  inputHash String
  data Json
  at DateTime
  @@unique([contentId, version])
}
model MetadataVersion {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  version Int
  stale Boolean
  inputHash String
  data Json
  at DateTime
  @@unique([contentId, version])
}
model QualityReview {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  version Int
  stale Boolean
  inputHash String
  data Json
  at DateTime
  @@unique([contentId, version])
}
model Approval {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  state String
  approver String?
  at DateTime
  versions Json
  packageHash String
  data Json
}
model Publication {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  provider String
  idempotencyKey String @unique
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId String?
  status String
  accountId String?
  containerId String?
  igMediaId String?
  permalink String?
  publicationPackageHash String?
  captionVersion Int?
  assetVersion Int?
  versions Json
  payload Json
  data Json
  @@index([provider, accountId, status])
}
model PerformanceSnapshot {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  observedAt DateTime
  metrics Json
  definitions Json
  data Json
}
model Learning {
  id String @id
  contentId String
  content ContentItem @relation(fields: [contentId], references: [id])
  statement String
  maturity String
  confidence String
  scope String
  evidence Json
  nextTest String?
  data Json
}
model WorkflowRun {
  workflowId String?
  workflowClass String?
  provider String?
  model String?
  llmCall Boolean @default(false)
  inputTokens Int?
  cachedInputTokens Int?
  outputTokens Int?
  reasoningTokens Int?
  totalTokens Int?
  estimatedInputTokens Int?
  latencyMs Int?
  actualCostUsd Float?
  estimatedCostUsd Float?
  costUsd Float?
  costSource String?
  budgetCharge Json?
  selectedReferences String[] @default([])
  id String @id
  contentId String?
  content ContentItem? @relation(fields: [contentId], references: [id])
  skill String
  inputHash String
  knowledgeHash String
  status String
  startedAt DateTime
  endedAt DateTime
  durationMs Int
  attempt Int
  input Json
  output Json
  data Json
  @@index([skill, inputHash, status])
  @@index([workflowId, startedAt])
  @@index([workflowClass, model, startedAt])
}
model AuditEvent {
  id String @id
  contentId String?
  kind String
  at DateTime
  data Json
  @@index([contentId, at])
}
model EditorialPlan {
  id String @id
  version Int @unique
  data Json
  at DateTime
}
model BenchmarkRecord {
  id String @id
  data Json
}
