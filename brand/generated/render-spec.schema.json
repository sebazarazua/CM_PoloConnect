{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polo Connect RenderSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "surface",
    "width",
    "height",
    "decision",
    "logo",
    "photo",
    "content",
    "sponsor",
    "interaction",
    "carousel",
    "provenance"
  ],
  "properties": {
    "mode": {
      "enum": [
        "study",
        "production"
      ]
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "depth_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "accent_intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "graphic_density": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "brand_energy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "background_complexity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,120}$"
    },
    "surface": {
      "enum": [
        "feed",
        "square",
        "story",
        "reel_cover",
        "carousel"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 320,
      "maximum": 4096
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "visualCarrier",
        "hierarchy",
        "density",
        "photoTreatment",
        "brandIntensity",
        "theme"
      ],
      "properties": {
        "family": {
          "enum": [
            "result-photo-dominant",
            "result-score-dominant",
            "result-celebration",
            "result-minimal",
            "fixture-matchup",
            "fixture-schedule",
            "fixture-tournament",
            "fixture-live-next",
            "news-breaking",
            "news-editorial",
            "news-announcement",
            "player-profile",
            "player-stat",
            "player-quote",
            "horse-profile",
            "horse-feature",
            "horse-stat-info",
            "reel-cover-action",
            "reel-cover-player",
            "reel-cover-result",
            "reel-cover-quote",
            "story-result",
            "story-fixture",
            "story-live",
            "story-link-replay",
            "story-poll-question",
            "carousel-cover",
            "carousel-context",
            "carousel-stat",
            "carousel-comparison",
            "carousel-quote",
            "carousel-conclusion"
          ]
        },
        "visualCarrier": {
          "enum": [
            "photo",
            "score",
            "type",
            "data",
            "quote"
          ]
        },
        "hierarchy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "score",
              "headline",
              "photo",
              "context"
            ]
          }
        },
        "density": {
          "enum": [
            "low",
            "standard"
          ]
        },
        "photoTreatment": {
          "enum": [
            "natural",
            "contrast",
            "none"
          ]
        },
        "brandIntensity": {
          "enum": [
            "subtle",
            "standard",
            "strong"
          ]
        },
        "theme": {
          "enum": [
            "dark",
            "light"
          ]
        }
      }
    },
    "logo": {
      "enum": [
        "horizontal",
        "icon"
      ]
    },
    "photo": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "sha256",
            "rights",
            "source",
            "synthetic",
            "credit",
            "focal"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 4000
            },
            "path": {
              "type": "string",
              "maxLength": 4000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rights": {
              "enum": [
                "owned",
                "licensed",
                "permission_confirmed"
              ]
            },
            "source": {
              "type": "string",
              "maxLength": 4000
            },
            "synthetic": {
              "type": "boolean"
            },
            "credit": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ]
            },
            "focal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "expiresAt": {
              "type": "string",
              "maxLength": 4000
            },
            "allowedSurfaces": {
              "type": "array",
              "items": {
                "enum": [
                  "feed",
                  "square",
                  "story",
                  "reel_cover",
                  "carousel"
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "headline",
        "subhead",
        "tournament",
        "stage",
        "score",
        "quote",
        "stats",
        "schedule"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 4000
        },
        "headline": {
          "type": "string",
          "maxLength": 4000
        },
        "subhead": {
          "type": "string",
          "maxLength": 4000
        },
        "tournament": {
          "type": "string",
          "maxLength": 4000
        },
        "stage": {
          "type": "string",
          "maxLength": 4000
        },
        "score": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "home",
                "away",
                "homeScore",
                "awayScore"
              ],
              "properties": {
                "home": {
                  "type": "string",
                  "maxLength": 4000
                },
                "away": {
                  "type": "string",
                  "maxLength": 4000
                },
                "homeScore": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "awayScore": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "attribution"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 4000
                },
                "attribution": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value",
              "unit"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 4000
              },
              "value": {
                "type": "string",
                "maxLength": 4000
              },
              "unit": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        },
        "schedule": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 4000
              },
              "value": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "sponsor": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "asset",
            "required"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 4000
            },
            "asset": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "path",
                "sha256",
                "rights",
                "source",
                "synthetic",
                "credit",
                "focal"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 4000
                },
                "path": {
                  "type": "string",
                  "maxLength": 4000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "rights": {
                  "enum": [
                    "owned",
                    "licensed",
                    "permission_confirmed"
                  ]
                },
                "source": {
                  "type": "string",
                  "maxLength": 4000
                },
                "synthetic": {
                  "type": "boolean"
                },
                "credit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 4000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "focal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "expiresAt": {
                  "type": "string",
                  "maxLength": 4000
                },
                "allowedSurfaces": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "feed",
                      "square",
                      "story",
                      "reel_cover",
                      "carousel"
                    ]
                  }
                }
              }
            },
            "required": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "interaction": {
      "enum": [
        "none",
        "link",
        "poll",
        "question"
      ]
    },
    "carousel": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "index",
            "total",
            "continuity"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 4000
            },
            "index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "total": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "continuity": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventVersion",
        "planHash",
        "simulated",
        "demoPlaceholder"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "maxLength": 4000
        },
        "eventVersion": {
          "type": "integer",
          "minimum": 1
        },
        "planHash": {
          "type": "string",
          "maxLength": 4000
        },
        "simulated": {
          "type": "boolean"
        },
        "demoPlaceholder": {
          "type": "boolean"
        }
      }
    }
  }
}
