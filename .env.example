# Los demos anteriores siguen siendo fixtures; automatización supervisada y dry-run por defecto.
REPOSITORY=file
DATA_FILE=.local/editorial.json
# Configurar sólo al usar REPOSITORY=postgres; nunca guardar la URL real en Git.
DATABASE_URL=
PYTHON_EXECUTABLE=
ENABLE_REAL_PUBLISHING=false
ENABLE_AUTO_APPROVAL=false
ENABLE_AUTO_RENDER=false
ENABLE_EXTERNAL_FETCHING=false
ENABLE_REAL_AI=false
# Gemini es el proveedor predeterminado. Pegar la key aquí y habilitar IA explícitamente.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_STANDARD=gemini-3.8-flash
GEMINI_MODEL_PREMIUM=gemini-3.8-flash
GEMINI_PRICING_FILE=config/pricing.gemini.json
# Alternativa compatible: AI_PROVIDER=openai y completar las variables siguientes.
OPENAI_API_KEY=
MODEL_FAST=
MODEL_STANDARD=
MODEL_PREMIUM=
MAX_SKILL_RETRIES=2
MAX_REROUTES=4

AUTOMATION_MODE=supervised
ENABLE_AUTO_PUBLISH=false
AUTOMATION_DRY_RUN=true
AUTOMATION_CONTENT_SOURCE=manual_queue
AUTOMATION_INSTAGRAM_ACCOUNT_ID=
AUTOMATION_ALLOW_FICTITIOUS=false
AUTOMATION_RENDER_DIRECTORY=outputs/automation
AUTOMATION_REPORT_DIRECTORY=outputs/automation-reports
# En Railway usar el volumen /app/.local y /app/.local/ai-usage.jsonl.
AI_USAGE_JOURNAL_FILE=.local/ai-usage.jsonl

# Instagram App ID/Secret del producto Instagram Login (no el App ID de Facebook).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:4318/integrations/instagram/callback
# Verificada en documentación oficial el 25-10-2026; configurable y sin fallback en código.
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=
# Opcional: clave AES de 32 bytes en base64. Si falta, vault.key privado en .local/instagram.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_LOCAL_PORT=4318
INSTAGRAM_PROXY_MODE=false
INSTAGRAM_TLS_KEY_FILE=
INSTAGRAM_TLS_CERT_FILE=

# Bucket privado. Credenciales AWS estándar o cadena de roles del SDK oficial.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_MEDIA_PREFIX=polo-connect/instagram/
S3_MEDIA_URL_TTL_SECONDS=86400
S3_MEDIA_RETENTION_DAYS=7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
